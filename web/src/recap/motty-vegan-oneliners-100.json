      "Build eventTags from fixture data (win/loss/draw, blowout, squeaker, bench, waiver, model_hit/miss, upset, titanic, vs_andrew, high_score, low_score, etc.).",
      "Score each line: +3 per matching specific tag, +1 for 'any', 0 if conflicting outcome (e.g. win line on loss \u2192 skip).",
      "Hard exclude: outcome mismatch (win tags on a loss fixture and vice versa) unless tags only contain any/swagger/theme.",
      "Among eligible, drop lines used in last cooldownGws (default 8) or already used this season if alternatives remain.",
      "Pick highest score; tie-break random among top tier.",
      "Never reuse same id twice in a season until bank exhausted."
    ],
    "conflictRules": {
      "win": [
        "loss",
        "low_score",
        "upset_victim"
      ],
      "loss": [
        "win",
        "high_score",
        "underdog"
      ],
      "draw": [
        "win",
        "loss"
      ]
    },
    "tone": "mates taking the piss \u2014 affectionate, never cruel"
  },
  "eventTaggers": {
    "win": "managerPts > opponentPts",
    "loss": "managerPts < opponentPts",
    "draw": "managerPts == opponentPts",
    "blowout": "abs(margin) >= 15",
    "squeaker": "0 < abs(margin) <= 3",
    "bench": "benchPts >= 8 || bestXiRegret >= 8",
    "waiver": "waiverPtsThisGw >= 6 || isRecentClaimTopScorer",
    "trade": "tradesInLast7d >= 2",
    "model_hit": "modelPick == winner",
    "model_miss": "modelPick != winner",
    "upset": "won && preMatchWinProb <= 0.40",
    "upset_victim": "lost && preMatchWinProb >= 0.60",
    "engine": "topPlayerShare >= 0.28",
    "engine_against": "opponent topPlayerShare >= 0.28 && loss",
    "title_quake": "abs(deltaTitlePct) >= 3",
    "tape": "h2hTapeUpdated",
    "high_score": "isGwTopScorer || pts == maxGwPts",
    "low_score": "isGwLowestScorer || pts == minGwPts",
    "heartbreak": "lost && abs(margin) <= 3",
    "heartbreak_dealt": "won && abs(margin) <= 3",
    "titanic": "fixture or weekly context involves Andrew Ward partnership narrative",
    "vs_andrew": "opponent is Andrew Ward",
    "dud": "hasStarterWithPts <= 2 && xP >= 4",
    "active": "transfersOrWaiversThisGw >= 1",
    "comeback": "won && wasBottomHalf",
    "slide": "lost && deltaRank <= -2",
    "heritage": "award or heritage surface",
    "arts_school": "rare flavour tag \u2014 optional manual/random low weight",
    "swagger": "always available soft tag for Motty",
    "odds": "preMatch odds available",
    "underdog": "won && preMatchWinProb <= 0.40",
    "best_xi": "bestXiRegret computed"
  },
