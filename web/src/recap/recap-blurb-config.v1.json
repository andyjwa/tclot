{
  "version": 1,
  "product": "TCLOT",
  "goal": "Fully automatic matchup blurbs: one data angle, constrained templates, personality as rare seasoning.",
  "fixturesPerGw": 4,
  "writeAllFixtures": true,
  "shape": {
    "maxSentences": 2,
    "sentence1": "fact_line",
    "sentence2": "voice_line_optional",
    "skipVoiceIfNoLoreHit": true,
    "scanMaxWords": 14,
    "columnMaxSentences": 2
  },
  "lengthPolicy": {
    "allFixturesGetFactLine": true,
    "columnUpgrade": {
      "enabled": true,
      "description": "All 4 get a fact line. Top 2 by interestingness may use a slightly richer template from the same angle pack (still \u22642 sentences). Bottom 2 stay scan-short.",
      "topN": 2
    }
  },
  "bans": {
    "leagueWidePerGw": {
      "percentOfTeamPhraseMax": 1,
      "sameOpenerPatternMaxPerManager": 1,
      "maxPersonalityRefsPerManager": 2,
      "maxPersonalityRefsLeagueWide": 4,
      "maxTitanicDuoMentions": 1
    },
    "phraseBlacklist": [
      "% of the",
      "% of their",
      "was percent of",
      "finished on",
      "led with",
      "best was",
      "the dud for"
    ],
    "fingerprintBan": "Do not list both teams' top scorers AND a % share AND the final total in the same blurb.",
    "neverPastePriorProseIntoPrompt": true
  },
  "qualityGates": [
    {
      "id": "max_sentences",
      "rejectIf": "sentenceCount > 2"
    },
    {
      "id": "pct_of_team_cap",
      "rejectIf": "containsPercentOfTeam && leagueAlreadyUsedPercentOfTeamThisGw"
    },
    {
      "id": "opener_cooldown",
      "rejectIf": "openerPatternId == lastGwOpenerPatternId[managerId]"
    },
    {
      "id": "joke_cooldown",
      "rejectIf": "loreLineId in usedLoreLineIdsThisSeason[-8:]"
    },
    {
      "id": "template_cooldown",
      "rejectIf": "templateId used for this manager in last 3 GWs OR used anywhere in this GW"
    },
    {
      "id": "must_use_angle_fact",
      "rejectIf": "!blurbContains(primaryFactTokens)"
    },
    {
      "id": "no_invented_stats",
      "rejectIf": "anyNumberNotInFactTable"
    },
    {
      "id": "rivalry_required",
      "rejectIf": "isNamedRivalry && !mentionsRivalryBrand"
    },
    {
      "id": "iconic_lore_cooldown",
      "rejectIf": "loreLine.iconic && (loreLineId used in last loreLine.cooldownGws GWs || seasonCount[loreLineId] >= loreLine.maxPerSeason)"
    }
  ],
  "regenerate": {
    "maxAttempts": 4,
    "onReject": "pickNextTemplateSameAngle else nextAngleByScore else scanOnlyFactLine"
  },
  "angles": [
    {
      "id": "margin_blowout",
      "pickWhen": "abs(homePts - awayPts) >= 15",
      "priority": 80,
      "interestingness": "abs(margin)"
    },
    {
      "id": "margin_squeaker",
      "pickWhen": "abs(homePts - awayPts) <= 3 && homePts != awayPts",
      "priority": 90,
      "interestingness": "4 - abs(margin)"
    },
    {
      "id": "stalemate",
      "pickWhen": "homePts == awayPts",
      "priority": 95,
      "interestingness": 100
    },
    {
      "id": "upset",
      "pickWhen": "winner.preMatchWinProb <= 0.40",
      "priority": 88,
      "interestingness": "loser.preMatchWinProb - winner.preMatchWinProb"
    },
    {
      "id": "model_miss",
      "pickWhen": "modelPick != winner && modelConfidence != null",
      "priority": 70,
      "interestingness": "modelConfidence"
    },
    {
      "id": "model_hit",
      "pickWhen": "modelPick == winner",
      "priority": 40,
      "interestingness": "margin"
    },
    {
      "id": "bench_regret",
      "pickWhen": "max(home.benchPts, away.benchPts) >= 8 || max(home.bestXiRegret, away.bestXiRegret) >= 8",
      "priority": 75,
      "interestingness": "max(benchPts, bestXiRegret)"
    },
    {
      "id": "waiver_haul",
      "pickWhen": "max(home.waiverPtsThisGw, away.waiverPtsThisGw) >= 8",
      "priority": 72,
      "interestingness": "max(waiverPtsThisGw)"
    },
    {
      "id": "engine",
      "pickWhen": "maxPlayerShareOfTeamPts >= 0.28",
      "priority": 35,
      "interestingness": "playerShare",
      "leagueWideCapPerGw": 1,
      "notes": "Use rarely \u2014 this is the old fingerprint. Prefer other angles when eligible."
    },
    {
      "id": "tape",
      "pickWhen": "h2hSeasonRecord exists && (revengeWin || firstMeeting || sweeps)",
      "priority": 65,
      "interestingness": 60
    },
    {
      "id": "title_quake",
      "pickWhen": "max(abs(deltaTitlePct)) >= 3",
      "priority": 78,
      "interestingness": "abs(deltaTitlePct)"
    },
    {
      "id": "rivalry",
      "pickWhen": "namedRivalry != null",
      "priority": 99,
      "interestingness": 85,
      "notes": "Angle can be rivalry-flavoured but MUST still attach one statistical claim from the winning competing angle."
    },
    {
      "id": "fallback_result",
      "pickWhen": "true",
      "priority": 1,
      "interestingness": "abs(margin)"
    }
  ],
  "angleSelection": {
    "perFixture": "Among eligible angles, take highest priority; break ties by interestingness. Then force exactly one. Rivalry brand is additive overlay when namedRivalry set \u2014 not a substitute for a stats angle unless rivalry+claim template used.",
    "leagueCaps": {
      "engine": 1,
      "margin_blowout": 2,
      "waiver_haul": 2
    },
    "cooldown": {
      "sameAngleSameManagerGws": 2
    }
  },
  "slots": [
    "winnerTeam",
    "loserTeam",
    "winnerMgr",
    "loserMgr",
    "winnerPts",
    "loserPts",
    "margin",
    "topPlayer",
    "topPlayerPts",
    "dudPlayer",
    "dudPlayerPts",
    "dudXp",
    "benchPts",
    "benchPlayer",
    "benchPlayerPts",
    "bestXiRegret",
    "waiverPlayer",
    "waiverPts",
    "modelPick",
    "modelCorrect",
    "winnerWinProb",
    "loserWinProb",
    "deltaTitleWinner",
    "deltaTitleLoser",
    "h2hTape",
    "rivalryName",
    "scoreline"
  ],
