# Optional: Cloudflare Worker base URL for the FPL draft/classic APIs (no trailing slash).
# Omit for local dev — `npm run dev:vite` and `npx vite preview` proxy same-origin `/__fpl`
# (see web/vite.config.js). Required for static deploys (e.g. GitHub Pages): set in CI / secrets
# so `vite build` embeds it.
#
# VITE_FPL_PROXY_URL=https://your-subdomain.workers.dev
